{
  "name": "@pbpyrojust/universal-accessibility-audit",
  "private": false,
  "type": "module",
  "scripts": {
    "build:urls": "node scripts/build-urls-from-sitemap.mjs --site https://www.example.com --out scripts/urls.txt",
    "audit:urls": "node scripts/a11y-audit.mjs --urls-file scripts/urls.txt --out-dir reports",
    "audit": "node scripts/run-audit.mjs --site https://www.example.com",
    "audit:crawl": "node scripts/a11y-audit.mjs --crawl --start https://www.example.com --max-pages 50 --out-dir reports",
    "report": "node scripts/generate-google-doc-report.mjs --run-dir reports/latest",
    "prepare": "husky",
    "version:bump": "node scripts/bump-version.mjs",
    "sitemap:xml-to-urls": "node scripts/convert-sitemap-xml-to-urls.mjs",
    "audit:slow": "node scripts/run-audit.mjs --slow --respect-robots --cloudflare-aware",
    "cli": "node bin/universal-a11y-audit.mjs",
    "pack:check": "npm pack --dry-run",
    "release:tag": "node -e \"const p=require('./package.json'); console.log('git tag v'+p.version+' && git push origin v'+p.version)\""
  },
  "dependencies": {
    "axe-core": "^4.11.1",
    "csv-stringify": "^6.6.0",
    "fast-xml-parser": "^5.3.3",
    "playwright": "^1.57.0"
  },
  "version": "0.2.2",
  "description": "CLI toolkit for accessibility audits with sitemap discovery, Playwright + axe-core scanning, browser-saved sitemap fallback, and ticket-ready outputs.",
  "author": "Justin Adams (https://justwhat.net)",
  "homepage": "https://github.com/pbpyrojust/universal-accessibility-audit#readme",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbpyrojust/universal-accessibility-audit.git"
  },
  "bugs": {
    "url": "https://github.com/pbpyrojust/universal-accessibility-audit/issues"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "axe-core",
    "playwright",
    "audit",
    "sitemap",
    "seo",
    "cli",
    "ticketing",
    "reporting"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "universal-a11y-audit": "bin/universal-a11y-audit.mjs",
    "uaaudit": "bin/universal-a11y-audit.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "preferGlobal": true
}
